# PostHog client-side configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://rpt.shelfscan.io
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.i.posthog.com

# Contact form (/contact) — server-only, sent via Resend
RESEND_API_KEY=re_your_resend_api_key
CONTACT_FROM_EMAIL="ShelfScan Contact <contact@send.shelfscan.io>"
# comma-separate multiple recipients
CONTACT_TO_EMAIL=you@example.com
